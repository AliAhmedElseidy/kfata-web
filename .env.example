DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=REPLACE_WITH_AT_LEAST_50_RANDOM_CHARACTERS_BEFORE_STARTING
POSTGRES_DB=kfata
POSTGRES_USER=kfata
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD
DATABASE_URL=postgres://kfata:REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD@db:5432/kfata
PUBLIC_BASE_URL=https://kfata.elsaidy.org
ALLOWED_HOSTS=kfata.elsaidy.org
SITE_INDEXABLE=false
TRUST_PROXY_HTTPS=true
# Set to the actual audited proxy IP/subnet; never trust all networks.
TRUSTED_PROXY_NETWORKS=
SECURE_SSL_REDIRECT=true
KFATA_LOCAL_PORT=8097
WEB_MEMORY=768m
WEB_CPUS=1.0
DB_MEMORY=512m
DB_CPUS=0.75
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
ENQUIRY_EMAIL=
ENQUIRY_RETENTION_DAYS=90
